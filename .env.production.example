# =============================================================
# Production Environment Variables
# Copy to .env.production and fill in all required values:
#   cp .env.production.example .env.production
# =============================================================

# ---- Postgres ----
POSTGRES_USER=formapp
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=formapp

# ---- Database URL (used by web, worker, and migrate) ----
# Host must be "postgres" (the Docker service name, not localhost)
DATABASE_URL=postgresql://formapp:change-me-to-a-strong-password@postgres:5432/formapp

# ---- Web: General ----
# Must match your public domain — baked into the client bundle at build time
VITE_BASE_URL=https://yourdomain.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---- Web: Payments (Creem) ----
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
PRODUCT_ID_STARTER=
PRODUCT_ID_PRO=

# ---- Web: OAuth (optional) ----
# Callback URL: https://yourdomain.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback URL: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Worker: Email (Resend) ----
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ---- Worker: Job Retry (optional, these are the defaults) ----
# JOB_RETRY_LIMIT=3
# JOB_RETRY_DELAY_SECONDS=60
# JOB_RETRY_BACKOFF=true
