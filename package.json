{
  "name": "form-app-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm --filter web build",
    "build:worker": "pnpm --filter worker build",
    "start": "pnpm --filter web start",
    "start:worker": "pnpm --filter worker start",
    "lint": "pnpm --filter web lint",
    "format": "pnpm --filter web format",
    "check-types": "pnpm --filter web check-types",
    "check": "pnpm format && pnpm lint && pnpm check-types",
    "db": "pnpm --filter web db",
    "deps": "pnpm dlx taze@latest -Ilw",
    "deps:major": "pnpm dlx taze@latest major -Ilw"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "typescript": "^5.9.3"
  }
}
