{
  "name": "form-app-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "dev:worker": "pnpm --filter @repo/worker dev",
    "build": "pnpm --filter @repo/web build",
    "build:worker": "pnpm --filter @repo/worker build",
    "start": "pnpm --filter @repo/web start",
    "start:worker": "pnpm --filter @repo/worker start",
    "lint": "pnpm --filter @repo/web lint",
    "format": "pnpm --filter @repo/web format",
    "check-types": "pnpm --filter @repo/web check-types",
    "check": "pnpm format && pnpm lint && pnpm check-types",
    "db": "pnpm --filter @repo/db db",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "deps": "pnpm dlx taze@latest -Ilw",
    "deps:major": "pnpm dlx taze@latest major -Ilw"
  },
  "devDependencies": {}
}
