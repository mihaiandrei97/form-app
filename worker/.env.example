# Database connection (same as main app)
DATABASE_URL=postgresql://user:password@localhost:5432/bforms

# Resend email service
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=notifications@bforms.dev

# Job retry configuration (optional)
JOB_RETRY_LIMIT=3
JOB_RETRY_DELAY_SECONDS=60
JOB_RETRY_BACKOFF=true
