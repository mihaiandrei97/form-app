{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tanstack": {
      // ...
      "enabled": true,
      "type": "local",
      "command": ["npx", "@tanstack/cli", "mcp"],
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true,
    },
    "better-auth": {
      "type": "remote",
      "url": "https://context7.com/better-auth/better-auth",
      "enabled": true,
    },
  },
}
