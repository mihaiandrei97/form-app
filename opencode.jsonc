{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tanstack": {
      // ...
      "enabled": true,
      "type": "local",
      "command": ["npx", "@tanstack/cli", "mcp"]
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    }
  }
}
